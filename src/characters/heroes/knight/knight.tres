[resource]
script = ExtResource("1_irecg")
profile = "A robust and resilient warrior, a master of defensive combat. He has the highest starting health among the heroes and withstands heavy blows on the front line. He moves more slowly, but his sword and shield make him a true wall against the dungeon's hordes."
max_health = 150.0
move_speed = 4.5
physical_damage_melee = 18.0
main_hand_weapon = 1
